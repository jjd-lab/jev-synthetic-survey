# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
# Virtual Environment
.venv/
# Environment Variables
.env
# IDE
.vscode/
# Cursor — ignore local/user state, keep project rules
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**
# Outputs. A live run writes here; what ships is copied into runs/ deliberately.
outputs*/
# Jupyter
.ipynb_checkpoints/
# Testing
.pytest_cache/
.coverage
htmlcov/
# Agent debug logs
debug-*.log
# Tee'd run logs - a run artifact, never committed
logs/
# Temporary files
temp/
notebooks/
data/
!src/data/
CLAUDE.md
# Working material that is not for publication: the session plan, bundle manifests, anything
# naming a private survey. Nothing in here may be committed.
private/
# .claude is ignored except skills/ — a negation can only re-include a path whose parent
# directory was not itself excluded, so this must be `.claude/*` (direct children) rather
# than `.claude`. settings.local.json stays ignored.
.claude/*
!.claude/skills/
# macOS Finder metadata
.DS_Store
# The n=300 arms ship uncompressed: git zlib-compresses blobs anyway, so an already-gzipped
# file costs it MORE to store, and a plain .jsonl is greppable and readable on the web.
# The 2,058-respondent panel file stays gzipped: 71 MB raw against 2.4 MB is not worth it.
