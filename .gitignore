# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
# Virtual Environment
.venv/
# Environment Variables
.env
# IDE
.vscode/
# Cursor — ignore local/user state, keep project rules
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**
# Outputs
outputs*/
hillclimb/runs/**/*.xlsx
hillclimb/runs/**/checkpoints/
hillclimb/runs/**/run*.log*
# Same class as the workbooks and run.log above: a run artifact that has to be moved between machines
# out of band, never committed. `run*.log*` does not cover it (no `.log` in the name), so exp-003's
# copy showed up as the one untracked file in an otherwise clean tree — noise in exactly the place
# where `git status` is what tells you the scoring tree is clean. Its content is quoted where it
# matters: provenance.accepted_run_errors and the G8 line in log.md.
hillclimb/runs/**/run_errors_*.jsonl
# Derived from the scorecard + workbook + script that are all already tracked, so versioning it would
# add a second copy of numbers git can already reproduce. Named for the script rather than by extension
# so it cannot swallow a future run artifact that does want tracking.
hillclimb/runs/**/multi_cardinality_*
# Jupyter
.ipynb_checkpoints/
# Testing
.pytest_cache/
.coverage
htmlcov/
# Agent debug logs
debug-*.log
# Tee'd run logs (see CLAUDE.md "Monitoring long runs") - a run artifact, never committed
logs/
# Temporary files
temp/
notebooks/
data/
!src/data/
CLAUDE.md
# Working material that is not for publication: the session plan, bundle manifests, anything
# naming a private survey. Nothing in here may be committed.
private/
# .claude is ignored except skills/ — a negation can only re-include a path whose parent
# directory was not itself excluded, so this must be `.claude/*` (direct children) rather
# than `.claude`. settings.local.json stays ignored.
.claude/*
!.claude/skills/